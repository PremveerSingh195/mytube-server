generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  password String?

  googleId     String? @unique
  profileImage String?
  provider     String  @default("LOCAL")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}